# Supabase browser/auth configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Legacy projects may use this instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Prisma runtime pooler (Supabase transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5"

# Prisma migrations and administrative commands (direct database, port 5432)
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Cloudflare R2 S3 API credentials
# Either R2_ACCOUNT_ID or the full R2_ENDPOINT is required.
R2_ACCOUNT_ID="..."
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET is supported as an alias for R2_BUCKET_NAME.
R2_BUCKET="eduportal-media"
R2_BUCKET_NAME="eduportal-media"
R2_PUBLIC_URL="https://media.example.com"
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.example.com"

# Optional browser Web Push (in-app notifications work without these values).
# Generate one stable key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BASE64URL_PUBLIC_KEY"
VAPID_PRIVATE_KEY="BASE64URL_PRIVATE_KEY"
VAPID_SUBJECT="mailto:notifications@example.com"

# Protects the daily Vercel Cron health-score refresh endpoint.
CRON_SECRET="generate-a-long-random-secret"

# HMAC key for 12-digit single-use access codes. Generate at least 32 random
# characters and keep the same value across all production instances.
DIGITAL_CODE_SECRET="generate-a-long-random-secret"
