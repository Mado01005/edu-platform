# Supabase browser/auth configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SITE_URL="https://edu-platform.me"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Legacy projects may use this instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Set true only after a Supabase SMS/WhatsApp provider is configured.
SUPABASE_PHONE_AUTH_CONFIGURED="false"

# Optional, local-only inputs for read-only OAuth configuration verification.
# Never expose the management token through a NEXT_PUBLIC_* variable.
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_ACCESS_TOKEN="sbp_..."

# Prisma runtime pooler (Supabase transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=10"

# Prisma migrations and administrative commands (direct database, port 5432)
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Cloudflare R2 S3 API credentials
# Either R2_ACCOUNT_ID or the full R2_ENDPOINT is required.
R2_ACCOUNT_ID="..."
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET is supported as an alias for R2_BUCKET_NAME.
R2_BUCKET="eduportal-media"
R2_BUCKET_NAME="eduportal-media"
R2_PUBLIC_URL="https://media.example.com"
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.example.com"

# Optional browser Web Push (in-app notifications work without these values).
# Generate one stable key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BASE64URL_PUBLIC_KEY"
VAPID_PRIVATE_KEY="BASE64URL_PRIVATE_KEY"
VAPID_SUBJECT="mailto:notifications@example.com"

# Optional payment-approval WhatsApp dispatcher. When omitted, access approval
# still succeeds and the server records the dispatch as FAILED for retry/audit.
WHATSAPP_WEBHOOK_URL="https://automation.example.com/webhooks/oqool-payments"
WHATSAPP_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Protects the daily Vercel Cron health-score refresh endpoint.
CRON_SECRET="generate-a-long-random-secret"
